{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!admin|blog|despre|contact|confidentialitate|termeni|cookies|sitemap).*\\.html)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!admin|blog|despre|contact|confidentialitate|termeni|cookies|sitemap|_next|api|favicon|background|minimaltechro).*)",
      "destination": "/index.html"
    }
  ]
}
